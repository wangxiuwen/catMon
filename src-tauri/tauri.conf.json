{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "catmon",
  "version": "0.1.0",
  "identifier": "dev.catmon.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "CatMon · 系统监视器",
        "width": 880,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false,
        "center": true,
        "focus": true
      },
      {
        "label": "ball",
        "url": "ball.html",
        "width": 84,
        "height": 84,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
